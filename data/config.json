{
  "ai": {
    "provider": "openai",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com/v1",
    "api_key_env": "DEEPSEEK_API_KEY"
  },
  "sources": {
    "rss": [
      {
        "name": "Hugging Face Blog",
        "url": "https://huggingface.co/blog/feed.xml",
        "profile": "ai-tech-focused"
      },
      {
        "name": "OpenAI Blog",
        "url": "https://openai.com/news/rss.xml",
        "profile": "ai-tech-focused"
      },
      {
        "name": "LangChain Blog",
        "url": "https://blog.langchain.dev/rss/",
        "profile": "ai-tech-focused"
      },
      {
        "name": "LlamaIndex Blog",
        "url": "https://www.llamaindex.ai/blog/rss.xml",
        "profile": "ai-tech-focused"
      },
      {
        "name": "NVIDIA Technical Blog",
        "url": "https://developer.nvidia.com/blog/feed/",
        "profile": "ai-tech-focused"
      },
      {
        "name": "Simon Willison Weblog",
        "url": "https://simonwillison.net/atom/everything/",
        "profile": "ai-tech-focused"
      }
    ],
    "hacker_news": [
      {
        "name": "Hacker News Top AI",
        "min_score": 50,
        "profile": "ai-tech-focused"
      }
    ],
    "reddit": {
      "subreddits": [
        {
          "name": "LocalLLaMA",
          "min_score": 30,
          "profile": "ai-tech-focused"
        },
        {
          "name": "MachineLearning",
          "min_score": 50,
          "profile": "ai-tech-focused"
        }
      ]
    }
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "ai-tech-focused",
    "profile_settings": {
      "ai-tech-focused": {
        "threshold": 6.5,
        "topic_dedup": true
      }
    }
  },
  "digest": {
    "max_items": 15
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.163.com",
    "smtp_port": 465,
    "imap_server": "imap.163.com",
    "use_tls": false,
    "use_ssl": true,
    "email_address": "13820386280@163.com",
    "sender": "13820386280@163.com",
    "password_env": "SMTP_PASSWORD",
    "recipients": [
      "13820386280@163.com"
    ]
  },
  "webhook": {
    "enabled": true,
    "type": "dingtalk",
    "url_env": "DINGTALK_WEBHOOK",
    "secret_env": "DINGTALK_SECRET"
  }
}
